{
  "$schema": "http://json.schemastore.org/template",
  "author": "João Vitor Lobo",
  "classifications": ["web", "api", "aspnet"],
  "identity": "TemplateDotnet.Template",
  "name": "Template Dotnet Template",
  "shortName": "referenceAuth",
  "sourceName": "Reference",
  "symbols": {
    "DomainName": {
      "type": "parameter",
      "description": "Domain name (replaces 'Reference')",
      "defaultValue": "MyApp",
      "replaces": "Reference"
    }
  },
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "exclude": [
    "**/bin/**",
    "**/obj/**",
    "**/.vs/**",
    "**/.vscode/**",
    ".git/**",
    ".gitignore",
    "*.user"
  ]
}
